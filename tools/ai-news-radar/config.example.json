    },
    {
      "name": "Analytics Insight",
      "url": "https://analyticsinsight.net/feed/",
      "requireKeyword": true
    },
    {
      "name": "Synced Review",
      "url": "https://syncedreview.com/feed/"
    },
    {
      "name": "Engadget AI",
      "url": "https://www.engadget.com/rss.xml",
      "requireKeyword": true
    },
    {
      "name": "The Neuron",
      "url": "https://www.theneuron.ai/feed"
    }
  ],
  "siteMaps": [
    {
      "name": "Anthropic News",
      "url": "https://www.anthropic.com/sitemap.xml",
      "include": ["/news/"]
    },
    {
      "name": "Google DeepMind Blog",
      "url": "https://deepmind.google/sitemap.xml",
      "include": ["/discover/blog/"]
    },
    {
      "name": "LlamaIndex Blog",
      "url": "https://www.llamaindex.ai/sitemap-index.xml",
      "include": ["/blog/"]
    },
    {
      "name": "DeepLearning.AI The Batch",
      "url": "https://www.deeplearning.ai/sitemap.xml",
      "include": ["/the-batch/"],
      "exclude": ["/tag/"]
    }
  ],
  "jsonSources": [
    {
      "name": "Hugging Face Daily Papers",
      "url": "https://huggingface.co/api/daily_papers",
      "type": "huggingFaceDailyPapers",
      "maxItems": 30
    }
  ],
  "redditFeeds": [
    {
      "name": "Reddit r/LocalLLaMA",
