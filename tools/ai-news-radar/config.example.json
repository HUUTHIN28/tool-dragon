    {
      "name": "Reddit r/OpenAI",
      "url": "https://www.reddit.com/r/OpenAI/new/.rss",
      "timeoutMs": 8000
    },
    {
      "name": "Reddit r/ClaudeAI",
      "url": "https://www.reddit.com/r/ClaudeAI/new/.rss",
      "timeoutMs": 8000
    },
    {
      "name": "Reddit r/artificial",
      "url": "https://www.reddit.com/r/artificial/new/.rss",
      "requireKeyword": true,
      "timeoutMs": 8000
    },
    {
      "name": "Reddit search: AI agents",
      "url": "https://www.reddit.com/search.rss?q=%22AI%20agents%22&sort=new&t=day",
      "timeoutMs": 8000
    },
    {
      "name": "Reddit search: agentic AI",
      "url": "https://www.reddit.com/search.rss?q=%22agentic%20AI%22&sort=new&t=day",
      "timeoutMs": 8000
    }
  ],
  "youtubeFeeds": [
    {
      "name": "OpenAI YouTube",
      "url": "https://www.youtube.com/feeds/videos.xml?channel_id=UCXZCJLdBC09xxGZ6gcdrc6A",
      "timeoutMs": 10000
    },
    {
      "name": "Google DeepMind YouTube",
      "url": "https://www.youtube.com/feeds/videos.xml?channel_id=UCP7jMXSY2xbc3KCAE0MHQ-A",
      "timeoutMs": 10000
    }
  ],
  "youtubeSearch": {
    "enabled": false,
    "apiKeyEnv": "YOUTUBE_API_KEY",
    "maxResultsPerQuery": 5,
    "queries": [
      "AI agents",
      "agentic AI",
      "OpenAI agent",
      "Claude AI",
      "Gemini AI",
      "LLM agents",
      "AI automation"
    ]
  },
  "email": {
    "from": "AI Radar <your-email@gmail.com>",
    "to": [
      "you@example.com"
    ],
    "subjectPrefix": "[AI Radar]",
    "smtp": {
      "hostEnv": "SMTP_HOST",
      "portEnv": "SMTP_PORT",
      "secureEnv": "SMTP_SECURE",
      "userEnv": "SMTP_USER",
      "passEnv": "SMTP_PASS"
    }
  }
