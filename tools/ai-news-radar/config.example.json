{
  "report": {
    "title": "AI Radar Digest",
    "timezone": "Asia/Ho_Chi_Minh",
    "hours": 24,
    "maxItems": 40,
    "maxNews": 40,
    "maxReddit": 20,
    "maxVideos": 20,
    "maxPerSource": 6,
    "requireKeyword": true,
    "sendWhenEmpty": false
  },
  "request": {
    "timeoutMs": 20000
  },
  "stateFile": ".ai-news-radar-state.json",
  "translation": {
    "enabled": false,
    "provider": "auto",
    "targetLanguage": "Vietnamese",
    "targetLangCode": "vi",
    "apiKeyEnv": "OPENAI_API_KEY",
    "modelEnv": "OPENAI_TRANSLATION_MODEL",
    "model": "gpt-4.1-mini"
  },
  "keywords": [
    "ai",
    "artificial intelligence",
    "agent",
    "agents",
    "agentic",
    "llm",
    "large language model",
    "openai",
    "chatgpt",
    "anthropic",
    "claude",
    "gemini",
    "deepmind",
    "copilot",
    "langchain",
    "langgraph",
    "llamaindex",
    "crewai",
    "autogen",
    "mcp"
  ],
